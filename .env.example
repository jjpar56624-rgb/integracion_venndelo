NODE_ENV=development
PORT=3000

# Venndelo API
VENNDELO_BASE_URL=https://api.venndelo.com/v1/admin
VENNDELO_TIMEOUT=30000

# Venndelo - Bogotá
VENNDELO_BOGOTA_API_KEY=your-bogota-api-key-here
VENNDELO_BOGOTA_STORE_ID=your-bogota-store-id-here
VENNDELO_BOGOTA_DRIVE_FOLDER_ID=your-bogota-drive-folder-id-here

# Venndelo - Cali
VENNDELO_CALI_API_KEY=your-cali-api-key-here
VENNDELO_CALI_STORE_ID=your-cali-store-id-here
VENNDELO_CALI_DRIVE_FOLDER_ID=your-cali-drive-folder-id-here

# Google Drive - OAuth2 (recomendado)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# Google Drive - Service Account (legado, opcional)
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
